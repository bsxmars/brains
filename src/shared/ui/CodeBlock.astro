---
/**
 * Блок кода, подсвеченный при сборке (`shared/lib/highlight.ts`). Язык по умолчанию — JS;
 * другой язык пишется явно (`lang="yaml"`), не-код — `lang="text"`, вывод — `tone="ok"`.
 *
 * Код приходит строкой в пропе, а не слотом: так его же данные можно прогнать тестом
 * (`tests/unit` исполняет примеры и сверяет вывод с тем, что написано на странице).
 * Fenced-блоки из MDX сюда не заходят — им хватает стиля элемента `pre` из base.css.
 *
 * `tone="ok"` — это вывод программы, а не её текст: в оригинале он зелёный (#A7E8BC).
 */
import { highlight, type CodeLang } from '@/shared/lib/highlight';

interface Props {
  code: string;
  /** Язык подсветки, по умолчанию `js`. `text` и вывод программы (`tone="ok"`) — одним цветом. */
  lang?: CodeLang;
  size?: number;
  lh?: number;
  pad?: string;
  /** `ink` — обычный блок, `deep` — блок внутри тёмной панели, `ok` — вывод в консоль. */
  tone?: 'ink' | 'deep' | 'ok';
}

const { code, lang = 'js', size = 12, lh = 1.7, pad = '13px 15px', tone = 'ink' } = Astro.props;
const html = lang !== 'text' && tone !== 'ok' ? await highlight(code, lang) : undefined;
---

<pre
  data-tone={tone}
  data-lang={tone === 'ok' ? 'text' : lang}
  style={`--code-fs:calc(${size}px * var(--fs-scale));--code-lh:${lh};--code-pad:${pad}`}>{html ? <Fragment set:html={html} /> : code}</pre>

<style>
  pre {
    padding: var(--code-pad);
    /* Нижняя граница — ступень `--fs-2`: проп `size={10.5}` давал 11.3px отрисованных,
       ниже порога читаемости. Крупные размеры проходят как заданы. */
    font-size: max(var(--code-fs), var(--fs-2));
    line-height: var(--code-lh);
  }
  pre[data-tone='deep'] {
    background: var(--ink-deep);
  }
  pre[data-tone='ok'] {
    color: var(--tone-ok-on-ink);
  }
</style>
