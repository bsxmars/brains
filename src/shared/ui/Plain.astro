---
/**
 * Врезка-объяснение рядом с термином: то же самое словами читателя, с бытовой аналогией.
 *
 * Без ярлыка «на пальцах» — это просто уточнение. Текст идёт пропом, чтобы строчная разметка
 * прошла через `inlineMd`. `Callout` для этого не годится: он самый громкий блок урока.
 */
import Card from './Card.astro';

interface Props {
  text: string;
}

const { text } = Astro.props;
---

<Card tone="info" color="tone" pad={16} radius={4} gap={9} size={15.5} lh={1.6} text={text} />
