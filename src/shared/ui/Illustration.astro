---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { inlineMd } from '@/shared/lib/format';

interface Props {
  id: string;
  image: ImageMetadata;
  title: string;
  alt: string;
  steps: string[];
  note: string;
}

const { id, image, title, alt, steps, note } = Astro.props;
---

<figure class="il" data-render-illustration={id}>
  <figcaption set:html={inlineMd(title)} />
  <div class="il-scroll" tabindex="0" role="region" aria-label={title}>
    <div class="il-content">
      <Image src={image} alt={alt} widths={[768, 1536]} sizes="(min-width: 1024px) 900px, 660px" format="webp" loading="lazy" />
      <ol class="il-steps">
        {steps.map((step) => <li set:html={inlineMd(step)} />)}
      </ol>
    </div>
  </div>
  <p class="il-note" set:html={inlineMd(note)} />
</figure>

<style>
  .il { margin: 0; min-width: 0; padding: 20px; background: var(--surface); border-radius: var(--r3); box-shadow: var(--shadow-card); }
  .il figcaption { color: var(--ink); font-size: var(--fs-7); font-weight: 600; line-height: 1.45; }
  .il-scroll { overflow-x: auto; margin-top: 12px; }
  .il-scroll:focus-visible { outline: 2px solid var(--tone-info-strong); outline-offset: 3px; }
  .il-content { min-width: 660px; }
  .il img { display: block; width: 100%; height: auto; }
  .il-steps { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin: 0; padding: 0 16px; list-style-position: inside; }
  .il-steps li { color: var(--prose); font-size: var(--fs-5); line-height: 1.5; }
  .il-note { margin: 16px 0 0; color: var(--text-muted); font-size: var(--fs-5); line-height: 1.6; }
</style>
