---
/**
 * Сетка карточек без брейкпоинтов: `auto-fit` + `minmax`.
 *
 * Так сделано в оригиналах, и это же единственный способ, которым они вообще отзывались на
 * ширину экрана: медиазапросов в бандлах нет ни одного.
 *
 * `align="start"` нужен там, где в ряду стоят карточки разной высоты и растягивать короткую
 * до высоты соседней не надо.
 */
interface Props {
  /** Минимальная ширина колонки, px. В оригиналах 240–310. */
  min?: number;
  gap?: number;
  align?: 'stretch' | 'start';
}

const { min = 280, gap = 14, align = 'stretch' } = Astro.props;
---

<div class="grid" style={`--grid-min:${min}px;--grid-gap:${gap}px;--grid-align:${align}`}>
  <slot />
</div>

<style>
  .grid {
    display: grid;
    /* `min(…, 100%)` — единственное отличие от оригинала, и оно про узкий экран: без него
       колонка шириной 290px в контейнере 272px не сжимается, а вылезает за край вместе
       со страницей. Там, где места хватает, поведение то же. */
    grid-template-columns: repeat(auto-fit, minmax(min(var(--grid-min), 100%), 1fr));
    gap: var(--grid-gap);
    align-items: var(--grid-align);
  }
  /* Решение автора курса (2026-09-28): сетка, в которой есть блок кода, идёт в один столбец.
     В колонке ~330px строки кода обрезались почти всюду (замер на 1280px: больше 60 сеток),
     а код читают целиком, а не прокручивают вбок. Сетки из одного текста остаются колонками. */
  /* `minmax(0, 1fr)`, а не `1fr`: у `1fr` нижняя граница — min-content, и строка кода с
     `white-space: pre` распирала колонку шире окна (layout.spec краснел на 59 страницах). */
  .grid:has(pre) {
    grid-template-columns: minmax(0, 1fr);
  }
</style>
