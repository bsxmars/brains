---
/**
 * Строка из данных как разметка — и ничего больше.
 *
 * Зачем отдельный компонент. В MDX текст, положенный внутрь компонента без пустых строк
 * вокруг, разметкой не считается: `` `код` `` и `**жирный**` доезжают до страницы буквально,
 * со звёздочками и кавычками. Строковые пропы курса эту разметку разбирают (`inlineMd`),
 * но проп годится не всегда: когда у текста есть соседи по слоту — список, блок кода, —
 * он обязан остаться на своём месте в порядке, а проп поставил бы его первым.
 *
 * Своего вида у компонента нет намеренно: размер, цвет и высоту строки задаёт окружение
 * (карточка, панель), иначе один и тот же текст выглядел бы по-разному в разных блоках.
 * Класс `md` нужен ровно одному правилу: абзац из данных, стоящий прямо в `<Section>`,
 * оформляется как проза раздела (`.section > .md` в `shared/styles/base.css`). Без него
 * такой абзац выходил мельче и плотнее соседних — замечено глазом 2026-09-29.
 */
import { inlineMd } from '@/shared/lib/format';

type Tag = 'div' | 'span' | 'p';

interface Props {
  text: string;
  /** `span` — когда текст стоит в строку с соседями, а не отдельным блоком. */
  as?: Tag;
}

const { text, as: TagName = 'div' } = Astro.props;
---

<TagName class="md" set:html={inlineMd(text)} />
