---
interface Props { copy: {
  title: string; description: string; signalingRow: string; directRow: string; relayRow: string;
  browserA: string; browserB: string; signaling: string; channel: string; data: string;
  turn: string; relay: string; stun: string; note: string;
}; }
const { copy } = Astro.props;
---
<figure class="icp" data-render-illustration="webrtc-signaling-media-paths">
  <figcaption>{copy.title}</figcaption>
  <div class="icp-scroll" role="region" tabindex="0" aria-label={copy.title}>
    <svg viewBox="0 0 900 590" role="img" aria-labelledby="icp-title icp-desc" fill="none">
      <title id="icp-title">{copy.title}</title>
      <desc id="icp-desc">{copy.description}</desc>
      <defs><marker id="icp-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 10 5 0 10Z" class="icp-arrow" /></marker></defs>
      <text x="20" y="28" class="icp-label">{copy.signalingRow}</text>
      <rect x="20" y="55" width="220" height="85" rx="14" class="icp-node" />
      <rect x="340" y="55" width="220" height="85" rx="14" class="icp-node icp-info" />
      <rect x="660" y="55" width="220" height="85" rx="14" class="icp-node" />
      <text x="130" y="105" class="icp-name">{copy.browserA}</text><text x="450" y="91" class="icp-name">{copy.signaling}</text><text x="450" y="120" class="icp-small">{copy.channel}</text><text x="770" y="105" class="icp-name">{copy.browserB}</text>
      <path d="M245 98H335" class="icp-route icp-signaling" marker-start="url(#icp-arrow)" marker-end="url(#icp-arrow)" />
      <path d="M565 98H655" class="icp-route icp-signaling" marker-start="url(#icp-arrow)" marker-end="url(#icp-arrow)" />
      <text x="20" y="220" class="icp-label">{copy.directRow}</text>
      <rect x="20" y="250" width="220" height="85" rx="14" class="icp-node" /><rect x="660" y="250" width="220" height="85" rx="14" class="icp-node" />
      <text x="130" y="300" class="icp-name">{copy.browserA}</text><text x="770" y="300" class="icp-name">{copy.browserB}</text>
      <path d="M245 293H655" class="icp-route" marker-start="url(#icp-arrow)" marker-end="url(#icp-arrow)" />
      <text x="450" y="275" class="icp-name">{copy.data}</text>
      <text x="20" y="415" class="icp-label">{copy.relayRow}</text>
      <rect x="20" y="445" width="220" height="85" rx="14" class="icp-node" /><rect x="340" y="445" width="220" height="85" rx="14" class="icp-node icp-warn" /><rect x="660" y="445" width="220" height="85" rx="14" class="icp-node" />
      <text x="130" y="495" class="icp-name">{copy.browserA}</text><text x="450" y="481" class="icp-name">{copy.turn}</text><text x="450" y="510" class="icp-small">{copy.relay}</text><text x="770" y="495" class="icp-name">{copy.browserB}</text>
      <path d="M245 488H335" class="icp-route" marker-start="url(#icp-arrow)" marker-end="url(#icp-arrow)" />
      <path d="M565 488H655" class="icp-route" marker-start="url(#icp-arrow)" marker-end="url(#icp-arrow)" />
      <text x="450" y="575" class="icp-small">{copy.stun}</text>
    </svg>
  </div>
  <p>{copy.note}</p>
</figure>
<style>
  .icp { margin: 0; padding: 22px; border-radius: var(--r3); box-shadow: var(--shadow-card); background: var(--surface); }
  .icp figcaption { color: var(--ink); font-size: var(--fs-7); font-weight: 600; line-height: 1.45; }
  .icp-scroll { overflow-x: auto; margin-top: 22px; }
  .icp svg { display: block; min-width: 900px; width: 100%; height: auto; }
  .icp-node { fill: var(--surface-2); stroke: var(--border-strong); }
  .icp-info { fill: var(--tone-info-bg); stroke: var(--tone-info-line); }
  .icp-warn { fill: var(--tone-warn-bg); stroke: var(--tone-warn-line); }
  .icp-name { fill: var(--ink); font-size: var(--fs-5); text-anchor: middle; font-family: var(--serif); }
  .icp-label { fill: var(--text-muted); font-size: var(--fs-3); font-family: var(--mono); }
  .icp-small { fill: var(--prose); font-size: var(--fs-3); text-anchor: middle; font-family: var(--mono); }
  .icp-route { stroke: var(--tone-ok-strong); stroke-width: 2; }
  .icp-signaling { stroke-dasharray: 7 5; }
  .icp-arrow { fill: var(--tone-ok-strong); }
  .icp p { margin: 12px 0 0; color: var(--text-muted); font-size: var(--fs-5); line-height: 1.6; }
</style>
