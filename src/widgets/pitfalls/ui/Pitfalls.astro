---
/**
 * «Тонкие места» — сетка пронумерованных карточек.
 *
 * Тон здесь не украшение, а степень опасности: без тона — просто факт, янтарный — место,
 * где легко ошибиться, красный — то, что молча съедает ошибку.
 */
import Card from '@/shared/ui/Card.astro';
import CardGrid from '@/shared/ui/CardGrid.astro';
import CodeBlock from '@/shared/ui/CodeBlock.astro';
import Md from '@/shared/ui/Md.astro';
import type { Pitfall } from '../model/types';

interface Props {
  items: Pitfall[];
}

const { items } = Astro.props;

/**
 * Ширину колонки задаёт сам виджет, а не тема.
 *
 * ⚠️ Раньше каждая тема передавала своё число (280…320), и на полосе в 1060px сетка
 * раскладывала тонкие места в **три** колонки. Строка выходила в полсотни знаков, код внутри
 * карточки переносился посреди выражения, а разная высота карточек рвала ряд на лоскуты.
 *
 * 480px при зазоре 14 дают ровно две колонки на широкой полосе и одну на узкой — без
 * медиазапросов, за счёт `auto-fit`. Тонкие места везде устроены одинаково, поэтому и ширина
 * у них одна: тема, которая захочет свою, скорее всего просто не заметила общего правила.
 */
const MIN_COLUMN = 480;

/**
 * Стрелка «→ как чинить» не должна висеть в конце строки, отдельно от того, на что указывает:
 * пробел после неё — неразрывный.
 */
const glueArrow = (text: string) => text.replace(/→ /g, '→\u00A0');
---

<CardGrid min={MIN_COLUMN} gap={14}>
  {
    items.map((item) => (
      <Card tone={item.tone ?? 'neutral'} index={item.n} title={item.t} titleSize={17} gap={12} size={15.5} lh={1.6}>
        {item.code && <CodeBlock code={item.code} />}
        {/* Через `Md`, а не слотом: в описании тонкого места почти всегда есть имя метода
            в обратных кавычках, и слот доставил бы его на страницу вместе с кавычками. */}
        <Md text={glueArrow(item.d)} />
      </Card>
    ))
  }
</CardGrid>
