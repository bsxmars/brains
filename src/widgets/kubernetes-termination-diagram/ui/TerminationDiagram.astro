---
/**
 * Удаление пода: две независимые цепочки на общей шкале, без паузы и с паузой в `preStop`.
 *
 * Схема «до и после» на одной сетке: колонки — порядок событий, а не секунды. Видно главное,
 * чего не видно из нумерованного списка: окно отказов — это отрезок, где `SIGTERM` уже пришёл,
 * а список адресов ещё не обновлён. Пауза в `preStop` не ускоряет вторую цепочку, а сдвигает
 * первую за её конец.
 *
 * Сетка на шесть колонок не складывается в столбик — время идёт слева направо, и на узком
 * экране прокручивается схема, а не страница.
 */
import { inlineMd } from '@/shared/lib/format';

interface Cell {
  t: string;
  from: number;
  to: number;
  tone: string;
}

interface Variant {
  k: string;
  bad: boolean;
  lanes: { k: string; cells: Cell[] }[];
}

interface Props {
  title: string;
  start: string;
  caption: string;
  foot: string;
  variants: Variant[];
}

const { title, start, caption, foot, variants } = Astro.props;
---

<figure class="ktd">
  <div class="t-eyebrow t-eyebrow--panel">{title}</div>

  <div class="ktd-scroll">
    <div class="ktd-body">
      {
        variants.map((v) => (
          <div class="ktd-variant">
            <div class="ktd-head">
              <span class="ktd-badge" data-bad={v.bad ? 'yes' : 'no'} set:html={inlineMd(v.k)} />
              <span class="ktd-start">▸ {start}</span>
            </div>
            <div class="ktd-grid">
              {v.lanes.map((lane, row) => (
                <>
                  <div class="t-label ktd-lane-k" style={`grid-row:${row + 1}`}>
                    {lane.k}
                  </div>
                  {lane.cells.map((c) => (
                    <div
                      class="ktd-cell"
                      data-tone={c.tone}
                      style={`grid-row:${row + 1};grid-column:${c.from + 1} / ${c.to + 1}`}
                      set:html={inlineMd(c.t)}
                    />
                  ))}
                </>
              ))}
            </div>
          </div>
        ))
      }
      <div class="ktd-axis" aria-hidden="true">время →</div>
    </div>
  </div>

  <figcaption class="ktd-cap">
    <span class="t-note" set:html={inlineMd(caption)} />
    <span class="t-note" set:html={inlineMd(foot)} />
  </figcaption>
</figure>

<style>
  .ktd {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
    padding: 22px;
    box-shadow: var(--shadow-2);
    border-radius: var(--r4);
    background: var(--surface);
  }

  .ktd-scroll {
    min-width: 0;
    overflow-x: auto;
  }
  .ktd-body {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 640px;
  }

  .ktd-variant {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ktd-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 12px;
  }
  .ktd-badge {
    padding: 3px 10px;
    border-radius: var(--r-full);
    font-size: var(--fs-4);
    font-weight: 600;
  }
  .ktd-badge[data-bad='yes'] {
    background: var(--tone-err-bg);
    color: var(--tone-err-strong);
  }
  .ktd-badge[data-bad='no'] {
    background: var(--tone-ok-bg);
    color: var(--tone-ok-strong);
  }
  .ktd-start {
    font-family: var(--mono);
    font-size: var(--fs-3);
    color: var(--text-muted);
  }

  .ktd-grid {
    display: grid;
    grid-template-columns: 8.5rem repeat(6, minmax(0, 1fr));
    gap: 5px 4px;
  }
  .ktd-lane-k {
    grid-column: 1;
    align-self: center;
  }

  .ktd-cell {
    display: flex;
    align-items: center;
    min-height: 34px;
    padding: 5px 9px;
    border: 1px solid var(--border);
    border-radius: var(--r1);
    font-size: var(--fs-3);
    line-height: 1.35;
    color: var(--text);
  }
  .ktd-cell[data-tone='info'] {
    border-color: var(--tone-info-line);
    background: var(--tone-info-bg);
    color: var(--tone-info-strong);
  }
  .ktd-cell[data-tone='warn'] {
    border-color: var(--tone-warn-line);
    background: var(--tone-warn-bg);
    color: var(--tone-warn-strong);
  }
  .ktd-cell[data-tone='ok'] {
    border-color: var(--tone-ok-line);
    background: var(--tone-ok-bg);
    color: var(--tone-ok-strong);
  }
  .ktd-cell[data-tone='err'] {
    border-color: var(--tone-err-line);
    background: var(--tone-err-bg);
    color: var(--tone-err-strong);
    font-weight: 600;
  }
  .ktd-cell[data-tone='dim'] {
    background: var(--surface-2);
    color: var(--text-muted);
  }

  .ktd-axis {
    align-self: flex-end;
    font-family: var(--mono);
    font-size: var(--fs-3);
    color: var(--text-faint);
  }

  .ktd-cap {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  @media (max-width: 640px) {
    .ktd {
      padding: 16px;
    }
  }
</style>
