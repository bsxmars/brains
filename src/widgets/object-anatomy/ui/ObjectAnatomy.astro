---
/**
 * Анатомия объекта: слева то, что физически лежит в `dog`, снизу — куда уходит поиск.
 *
 * Картинка отвечает на один вопрос: где проходит граница между «свойством» и «слотом».
 * Слоты нарисованы отдельным блоком и без рамок-ячеек — у них нет ключей, их не перечислить
 * и не скопировать. Свойства — таблицей с дескриптором, потому что свойство это и есть
 * пара «ключ → дескриптор», а не «ключ → значение»: у аксессора значения нет вовсе.
 *
 * Ни одна рамка здесь не обозначает «класс». `Dog.prototype` и `Animal.prototype` — обычные
 * объекты, и нарисованы они так же, как `dog`.
 */
import { inlineMd } from '@/shared/lib/format';
import type { AnatomyProperty, AnatomyProto, AnatomySlot } from '../model/types';

interface Props {
  /** Заголовок объекта и выражение, которым он создан. */
  title: string;
  made: string;
  slots: AnatomySlot[];
  props: AnatomyProperty[];
  chain: AnatomyProto[];
  /** Подпись у конца цепочки. */
  tail?: string;
}

const { title, made, slots, props, chain, tail = 'null — конец цепочки' } = Astro.props;
---

<div class="anatomy">
  <div class="object">
    <div class="object__head">
      <span class="object__title">{title}</span>
      <span class="object__made">{made}</span>
    </div>

    <div class="group">
      <div class="t-label">внутренние слоты — не свойства</div>
      <div class="slots">
        {
          slots.map((slot) => (
            <div class="slot">
              <span class="slot__name">{slot.name}</span>
              <span class="slot__value">{slot.value}</span>
            </div>
          ))
        }
      </div>
    </div>

    <div class="group">
      <div class="t-label">собственные свойства → дескрипторы</div>
      <div class="props">
        {
          props.map((prop) => (
            <div class="prop" data-kind={prop.kind}>
              <div class="prop__row">
                <span class="prop__key">{prop.key}</span>
                <span class="prop__value">{prop.value}</span>
              </div>
              <div class="prop__flags">
                <span class="prop__kind">{prop.kind}</span>
                {prop.flags.map((flag) => (
                  <span class="flag">{flag}</span>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="chain">
    <div class="t-label">куда уходит поиск</div>

    {
      chain.map((node, i) => (
        <div class="proto-link">
          {i > 0 && <div class="proto-arrow">↓ [[Prototype]]</div>}
          <div class="proto">
            <span class="proto__name">{node.name}</span>
            <span class="proto__body">{node.body}</span>
            {node.note && <span class="proto__note" set:html={inlineMd(node.note)} />}
          </div>
        </div>
      ))
    }

    <div class="proto-arrow">↓ [[Prototype]]</div>
    <div class="tail">{tail}</div>
  </div>
</div>

<style>
  .anatomy {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 18px;
    align-items: start;
  }

  .object,
  .chain {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 20px;
    border-radius: var(--r4);
    background: var(--surface);
    box-shadow: var(--shadow-2);
    min-width: 0;
  }

  .object__head {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .object__title {
    font-family: var(--mono);
    font-size: var(--fs-5);
    font-weight: 600;
    color: var(--ink);
  }
  .object__made {
    font-family: var(--mono);
    font-size: var(--fs-3);
    color: var(--text-faint);
  }

  .group {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  /* Слоты без рамок и без ячеек: у них нет ключей, они не перечисляются и не копируются.
     Ровно поэтому они не должны выглядеть как строки таблицы свойств рядом. */
  .slots {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 11px 13px;
    border-radius: var(--r2);
    background: var(--surface-2);
  }
  .slot {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 10px;
  }
  .slot__name {
    font-family: var(--mono);
    font-size: var(--fs-3);
    font-weight: 600;
    color: var(--tone-info-strong);
  }
  .slot__value {
    font-family: var(--mono);
    font-size: var(--fs-3);
    color: var(--text-muted);
  }

  .props {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  /* Свойство — объект уровня чернил: у него есть настоящая граница, и рамка её и рисует. */
  .prop {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px 12px;
    border: 1px solid var(--border);
    border-radius: var(--r2);
  }
  .prop[data-kind='accessor'] {
    border-color: var(--tone-warn-line);
    background: var(--tone-warn-bg);
  }

  .prop__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 4px 10px;
  }
  .prop__key {
    font-family: var(--mono);
    font-size: var(--fs-3);
    font-weight: 600;
    color: var(--ink);
  }
  .prop__value {
    font-family: var(--mono);
    font-size: var(--fs-3);
    color: var(--text-muted);
  }

  .prop__flags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  .prop__kind {
    padding: 2px 8px;
    border-radius: var(--r-full);
    background: var(--surface-3);
    font-family: var(--mono);
    font-size: var(--fs-2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--chip-text);
  }
  .prop[data-kind='accessor'] .prop__kind {
    background: var(--tone-warn-chip);
    color: var(--tone-warn-strong);
  }
  .flag {
    padding: 2px 8px;
    border-radius: var(--r-full);
    font-family: var(--mono);
    font-size: var(--fs-3);
    color: var(--dim);
  }

  .proto-link {
    display: flex;
    flex-direction: column;
  }
  .proto {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: var(--r2);
  }
  .proto__name {
    font-family: var(--mono);
    font-size: var(--fs-3);
    font-weight: 600;
    color: var(--ink);
  }
  .proto__body {
    font-family: var(--mono);
    font-size: var(--fs-2);
    line-height: 1.5;
    color: var(--text-muted);
  }
  .proto__note {
    font-size: var(--fs-5);
    line-height: 1.5;
    color: var(--prose);
  }

  .proto-arrow {
    padding: 6px 0 6px 2px;
    font-family: var(--mono);
    font-size: var(--fs-2);
    color: var(--text-faint);
  }

  .tail {
    padding: 9px 14px;
    border: 1px dashed var(--border-strong);
    border-radius: var(--r2);
    font-family: var(--mono);
    font-size: var(--fs-3);
    color: var(--dim);
  }
</style>
