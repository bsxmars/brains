---
/**
 * Порядок контроллера StatefulSet: три полосы — создание, удаление, обновление.
 *
 * Четыре гарантии в теме записаны списком, и направление в нём — слова «по возрастанию»
 * и «по убыванию». На схеме направление — это порядок фишек, а условие перехода подписано
 * прямо на стрелке: видно, что каждый шаг ждёт, и что одна зависшая реплика держит всё,
 * что стоит после неё.
 */
import { inlineMd } from '@/shared/lib/format';

interface Props {
  title: string;
  caption: string;
  lanes: { k: string; pods: string[]; wait: string; tone: string }[];
}

const { title, caption, lanes } = Astro.props;
---

<figure class="sod">
  <div class="t-eyebrow t-eyebrow--panel">{title}</div>

  <div class="sod-lanes">
    {
      lanes.map((lane) => (
        <div class="sod-lane" data-tone={lane.tone}>
          <div class="sod-lane-k" set:html={inlineMd(lane.k)} />
          <div class="sod-flow">
            {lane.pods.map((pod, i) => (
              <>
                {i > 0 && (
                  <span class="sod-step">
                    <span class="sod-wait">{lane.wait}</span>
                    <span class="sod-arrow" aria-hidden="true" />
                  </span>
                )}
                <span class="sod-pod">{pod}</span>
              </>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <figcaption class="t-note" set:html={inlineMd(caption)} />
</figure>

<style>
  .sod {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
    padding: 22px;
    box-shadow: var(--shadow-2);
    border-radius: var(--r4);
    background: var(--surface);
  }

  .sod-lanes {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .sod-lane {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    align-items: center;
    gap: 12px;
  }
  .sod-lane-k {
    font-size: var(--fs-4);
    font-weight: 600;
    color: var(--text);
  }

  .sod-flow {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .sod-pod {
    flex: none;
    padding: 8px 12px;
    border-radius: var(--r2);
    font-family: var(--mono);
    font-size: var(--fs-4);
    font-weight: 600;
  }
  .sod-step {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    text-align: center;
  }
  .sod-wait {
    font-size: var(--fs-3);
    line-height: 1.3;
    color: var(--text-muted);
  }
  /* Стрелка — линия с остриём, растянутая на весь промежуток между фишками. */
  .sod-arrow {
    position: relative;
    align-self: stretch;
    height: 2px;
    margin: 6px 8px 0 0;
    background: currentcolor;
  }
  .sod-arrow::after {
    content: '';
    position: absolute;
    top: -4px;
    right: -8px;
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    border-left: 8px solid currentcolor;
  }

  .sod-lane[data-tone='ok'] .sod-pod {
    border: 1px solid var(--tone-ok-line);
    background: var(--tone-ok-bg);
    color: var(--tone-ok-strong);
  }
  .sod-lane[data-tone='ok'] .sod-arrow {
    color: var(--tone-ok-strong);
  }
  .sod-lane[data-tone='err'] .sod-pod {
    border: 1px solid var(--tone-err-line);
    background: var(--tone-err-bg);
    color: var(--tone-err-strong);
  }
  .sod-lane[data-tone='err'] .sod-arrow {
    color: var(--tone-err-strong);
  }
  .sod-lane[data-tone='info'] .sod-pod {
    border: 1px solid var(--tone-info-line);
    background: var(--tone-info-bg);
    color: var(--tone-info-strong);
  }
  .sod-lane[data-tone='info'] .sod-arrow {
    color: var(--tone-info-strong);
  }

  /* На узком экране подпись полосы встаёт над ней, а цепочка идёт сверху вниз. */
  @media (max-width: 640px) {
    .sod {
      padding: 16px;
    }
    .sod-lane {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
    }
    .sod-flow {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }
    .sod-step {
      flex-direction: row-reverse;
      gap: 8px;
      padding-left: 20px;
      text-align: start;
    }
    .sod-step {
      align-items: center;
    }
    .sod-arrow {
      align-self: auto;
      flex: none;
      width: 2px;
      height: 18px;
      margin: 0 0 8px;
    }
    .sod-arrow::after {
      top: auto;
      right: -4px;
      bottom: -8px;
      border-top: 8px solid currentcolor;
      border-right: 5px solid transparent;
      border-bottom: 0;
      border-left: 5px solid transparent;
    }
  }
</style>
