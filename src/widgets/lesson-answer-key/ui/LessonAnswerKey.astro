---
/** Открытый минимум темы: ключевой механизм и границы его применения. */
import type { AnswerKey } from '@/entities/lesson';
import { inlineMd } from '@/shared/lib/format';

interface Props {
  answerKey: AnswerKey;
}

const { answerKey } = Astro.props;
---

<section class="key" aria-labelledby="summary">
  <h2 id="summary" class="heading">Саммари</h2>
  <div class="block" data-summary-core>
    <h3 class="title">Ядро</h3>
    <ul class="list">
      {answerKey.items.map((item) => (
        <li>
          <span set:html={inlineMd(item.text)} />
          {item.steps.length > 0 && (
            <ol class="steps">
              {item.steps.map((step) => <li set:html={inlineMd(step)} />)}
            </ol>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .key {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 72px;
    padding-top: 28px;
    border-top: 1px solid var(--ink);
  }
  .heading {
    margin: 0;
    font-size: var(--fs-h3);
    line-height: 1.2;
  }
  .block {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px;
    border-radius: var(--r2);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }
  .title {
    margin: 0;
    font-size: var(--fs-7);
    line-height: 1.4;
    font-weight: 600;
    color: var(--text);
  }
  .list {
    margin: 0;
    padding: 0 0 0 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: var(--fs-6);
    line-height: 1.6;
    color: var(--prose);
    text-align: justify;
    hyphens: auto;
  }
  .steps {
    margin: 6px 0 0;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
</style>
