---
/**
 * Выход к списку уроков.
 *
 * Живёт не в шапке урока, а в полосе над ней, и это не про вкус: колонка текста шириной
 * 1060px на широком экране стоит далеко от края, и ссылка, попав в неё, оказывалась внутри
 * материала. Здесь она прижата к краю страницы — там, где её ищут глазами, и там, где она
 * никому не мешает читать.
 */
interface Props {
  href?: string;
  label?: string;
  /** Прилипать к верху при прокрутке. */
  sticky?: boolean;
  /**
   * На сколько отступить от верха, px.
   *
   * На списке направления полоса одна и прилипает к нулю. На странице темы над ней стоит
   * липкая навигация по разделам — там стрелка обязана встать **под** неё, иначе полосы
   * наложатся. Высота навигации передаётся числом, а не зашита здесь: виджет не должен знать
   * про соседа, а страница — знает обоих.
   */
  stickyTop?: number;
}

const { href = '/', label = 'все уроки', sticky = false, stickyTop = 0 } = Astro.props;
---

{
  sticky && (
    <div class="pin" style={stickyTop ? `--back-top:${stickyTop}px` : undefined}>
      <a class="pin__link" href={href} aria-label={label}>
        ←
      </a>
    </div>
  )
}
<div
  class:list={['row', sticky && 'row--sticky']}
  style={sticky && stickyTop ? `--back-top:${stickyTop}px` : undefined}
>
  <a class="back" href={href}>
    <span class="back__arrow" aria-hidden="true">←</span>{label}
  </a>
</div>

<style>
  .row {
    padding: 28px 0 0;
  }

  /* Липнет только там, где ссылке хватает поля слева от колонки текста (решение автора курса
     2026-10-28). Полоса прозрачная и пропускает клики: текст едет под ней видимым, а сама ссылка
     стоит в пустом поле и ничего не закрывает. Раньше полоса была сплошной белой лентой во всю
     ширину и прятала под собой строку-другую текста.
     Порог 1400px — замер: правый край ссылки ≈233px, колонка начинается правее с 1366px.
     Уже — ссылке негде встать сбоку, и она прокручивается вместе со страницей.
     Слой ниже, чем у полосы разделов (там 50): навигация проходит поверх стрелки. */
  @media (min-width: 1400px) {
    .row--sticky {
      position: sticky;
      top: var(--back-top, 0px);
      z-index: 20;
      padding: 20px 0 14px;
      pointer-events: none;
    }
    .row--sticky .back {
      pointer-events: auto;
    }
  }

  /* Уже 1400px сбоку нет поля под всю подпись, и липнет одна стрелка (решение автора курса
     2026-10-28). Она стоит ровно на месте стрелки подписи: вверху страницы накрывает её, и двойной
     не видно, а при прокрутке подпись уходит, стрелка остаётся. Нулевая высота — ничего не сдвигает.
     Уже 1024px страница идёт без масштаба 0.8, поле до колонки — 24px, и стрелка легла бы на текст:
     там не липнет ничего (замер 2026-10-28 на 390–1100px). */
  .pin {
    display: none;
  }
  @media (min-width: 1024px) and (max-width: 1399px) {
    .pin {
      display: block;
      position: sticky;
      top: var(--back-top, 0px);
      z-index: 20;
      height: 0;
    }
    .pin__link {
      position: absolute;
      top: var(--pin-y, 28px);
      left: var(--pin-x, 0px);
      font-family: var(--mono);
      font-size: var(--fs-8);
      line-height: 1;
      text-decoration: none;
      color: var(--text-muted);
      transition: transform 0.18s, color 0.18s;
    }
    .pin__link:hover {
      color: var(--ink);
      transform: translateX(-3px);
    }
    .row--sticky .back__arrow {
      visibility: hidden;
    }
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: var(--fs-5);
    line-height: 1;
    text-decoration: none;
    color: var(--text-muted);
    transition: all 0.18s;
  }
  .back__arrow {
    font-size: var(--fs-8);
    line-height: 1;
    transition: transform 0.18s;
  }
  .back:hover {
    color: var(--ink);
  }
  .back:hover .back__arrow {
    transform: translateX(-3px);
  }
</style>
